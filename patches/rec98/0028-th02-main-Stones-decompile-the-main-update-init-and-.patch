 th02/main/boss/stones.cpp | 315 +++++++++++++++++
 th02/main/hittest.asm     |   2 +-
 th02_main.asm             | 709 +++++++-------------------------------
 4 files changed, 445 insertions(+), 582 deletions(-)
 create mode 100644 th02/main/boss/stones.cpp

