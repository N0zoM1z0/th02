+
+// Segment 1, after the stage loop
+// -------------------------------
+
+extern "C" void pascal near text_wipe(void)
+{
+	text_clear();
+	text_fillca(' ', (TX_BLACK | TX_REVERSE));
+}
+
+void nullfunc_void(void)
+{
+}
+
+int nullfunc_false(void)
+{
+	return false;
+}
+
+extern void (far *boss_init)(void);
+extern void (far *boss_end)(void);
+extern void (far *boss_bg_render_func)(void);
+extern stage_progression_t (far *boss_update_func)(void);
+extern uint8_t bgm_show_timer;
+extern uint8_t bgm_title_id;
+extern uint8_t byte_1F46E;
+extern const char near *BGM_TITLES[];
+extern const char aEMPTY[];
+void sub_17A55(void);
+void sub_16A8A(void);
+
+int sub_BF9C(void)
+{
+	if(stage_progression == SP_CLEAR) {
+		if(stage_id == 2) {
+			Palettes[0].c.r = 0;
+			Palettes[0].c.g = 0;
+			Palettes[0].c.b = 0;
+			palette_show();
+		}
+		boss_end();
+		return 1;
+	}
+	return 0;
+}
+
+void sub_BFD0(void)
+{
+	if(scroll_done == true) {
+		stage_progression = SP_BOSS;
+		if(stage_id == 3) {
+			farfp_1F490 = nullfunc_void;
+		} else if(stage_id == 2) {
+			Palettes[0].c.r = 0;
+			Palettes[0].c.g = 0;
+			Palettes[0].c.b = 0;
+			palette_show();
+		}
+		boss_init();
+		sub_17A55();
+		sub_16A8A();
+		farfp_1F494 = nullfunc_void;
+		boss_bg_render = boss_bg_render_func;
+		boss_update = boss_update_func;
+		farfp_1F48C = sub_BF9C;
+		scroll_cycle = -1;
+		bgm_show_timer = 1;
+		bgm_title_id = byte_1F46E;
+	}
+}
+
+void sub_C05D(void)
+{
+	if(stage_frame == 160) {
+		if(resident->demo_num == 0) {
+			text_putsa(4, 12, aEMPTY, TX_WHITE);
+			text_putsa(4, 13, aEMPTY, TX_WHITE);
+		}
+		farfp_1F498 = nullfunc_void;
+	}
+}
+
+void near bgm_show(void)
+{
+	if(bgm_show_timer) {
+		if(bgm_show_timer == 1) {
+			gaiji_putca(24, 23, gs_NOTES, TX_YELLOW);
+			text_putsa(26, 23, BGM_TITLES[bgm_title_id], TX_WHITE);
+		}
+		bgm_show_timer++;
+		if(bgm_show_timer >= 160) {
+			text_putsa(24, 23, &aEMPTY[22], TX_WHITE);
+			bgm_show_timer = 0;
+		}
+	}
+}
+
+void near egc_start_copy_1(void)
+{
+	egc_on();
+	egc_setup_copy();
+}
+
+extern const char aDemo1_rec[];
+extern const char aDemo2_rec[];
+extern const char aDemo3_rec[];
+
+void demo_load(void)
+{
+	DemoBuf = reinterpret_cast<input_t far *>(hmem_allocbyte(DEMO_N * 2));
+	power = POWER_MAX;
+	playperf = 12;
+	resident->frame = 18;
+	if(resident->demo_num == 1) {
+		stage_id = 3;
+		file_ropen(aDemo1_rec);
+		resident->shottype = 0;
+	} else if(resident->demo_num == 2) {
+		stage_id = 2;
+		file_ropen(aDemo2_rec);
+		resident->shottype = 2;
+	} else if(resident->demo_num == 3) {
+		stage_id = 1;
+		file_ropen(aDemo3_rec);
+		resident->shottype = 1;
+	}
+	file_read(DemoBuf, (DEMO_N * 2));
+	file_close();
+}
+
+extern "C" void pascal DemoPlay(void)
+{
+	if(key_det == 0) {
+		key_det = DemoBuf[demo_frame];
+		demo_frame++;
+		if(demo_frame < (DEMO_N - 50)) {
+			return;
+		}
+	}
+	key_det = 0;
+	palette_black_out(10);
+	quit = true;
+	snd_se_reset();
+}
+
+void near randring_fill(void)
+{
+	int i = 0;
+	do {
+		randring[i] = irand();
+		i++;
+	} while(i < RANDRING_SIZE);
+}
+
+#define RANDRING_INSTANCE 1
+#include "th02/math/randring.cpp"
