Subject: [PATCH] Define stage 3's uninitialized variables in C++

---
 th02/stage3.cpp | 39 ++++++++++++++++++++++---
 th02_main.asm   | 77 +------------------------------------------------
 2 files changed, 36 insertions(+), 80 deletions(-)

diff --git a/th02/stage3.cpp b/th02/stage3.cpp
index 59f44928..8b8b5f45 100644
--- a/th02/stage3.cpp
+++ b/th02/stage3.cpp
@@ -38,10 +38,6 @@
 #include "th02/main/item/item.hpp"
 
 static const pixel_t STONE_W = 32;
-
-extern screen_x_t stone_left[STONE_COUNT];
-extern screen_y_t stone_top[STONE_COUNT];
-extern int stone_patnum[STONE_COUNT];
 extern screen_x_t shot_target_left;
 extern screen_y_t shot_target_top;
 
@@ -49,5 +45,40 @@ int pascal near shots_hittest(
 	screen_x_t left, screen_y_t top, pixel_t w, pixel_t h
 );
 
+// Uninitialized data, in the original order
+#pragma option -a2
+int stone_patnum[STONE_COUNT];
+uint8_t stones_phase;
+uint8_t stones_pattern;
+long stone_frames;
+screen_x_t* midboss3_left_on_back_page[STONE_COUNT];
+screen_y_t* midboss3_top_on_back_page[STONE_COUNT];
+screen_x_t stone_left[STONE_COUNT];
+screen_y_t stone_top[STONE_COUNT];
+screen_x_t stones_bullet_left;
+screen_y_t stones_bullet_top;
+vram_y_t stones_y_22D9C;
+pixel_t stage3_bg_radius;
+screen_x_t stage3_bg_center_x;
+screen_y_t stage3_bg_center_y;
+unsigned char stage3_bg_angle;
+screen_point_t stage3_bg_dots[PAGE_COUNT][64];
+unsigned char midboss3_angle[MIDBOSS3_COUNT];
+uint8_t midboss3_rounds;
+int stones_pattern_frame;
+screen_x_t stones_pillar_left;
+uint8_t stones_pillar_state;
+unsigned char angle_22FAF;
+unsigned char angle_22FB0;
+unsigned char angle_22FB1[STONE_COUNT];
+uint8_t stones_ring_tile_flag[TILES_X];
+uint8_t stones_ring_phase;
+uint8_t stones_ring_i;
+uint8_t stones_ring_done;
+int stones_ring_tile_1;
+int stones_ring_tile_2;
+int stones_ring_tile_3;
+#pragma option -a-
+
 #include "th02/main/midboss/m3.cpp"
 #include "th02/main/boss/b3.cpp"
diff --git a/th02_main.asm b/th02_main.asm
index eef1a540..16505fd9 100644
--- a/th02_main.asm
+++ b/th02_main.asm
@@ -35,6 +35,7 @@ include th02/sprites/main_pat.inc
 	extern _memcpy:proc
 
 playperf_min = -6
+STONE_COUNT = 5
 
 SP_STAGE = 0
 SP_BOSS = 1
@@ -1012,81 +1013,5 @@ public _shot_cooldown_1
 _shot_cooldown_1	db ?
 public _shot_cooldown_2
 _shot_cooldown_2	db ?
-public _stone_patnum
-_stone_patnum	dw 5 dup(?)
-public _stones_phase
-_stones_phase	db ?
-public _stones_pattern
-_stones_pattern	db ?
-public _stone_frames
-_stone_frames	dd ?
-
-MIDBOSS3_COUNT = 2
-
-public _midboss3_left_on_back_page, _midboss3_top_on_back_page
-_midboss3_left_on_back_page	dd STONE_COUNT dup (?)
-_midboss3_top_on_back_page	dd STONE_COUNT dup (?)
-
-STONE_INNER_WEST = 0
-STONE_INNER_EAST = 1
-STONE_OUTER_WEST = 2
-STONE_OUTER_EAST = 3
-STONE_NORTH = 4
-STONE_COUNT = 5
-
-STONE_W = 32
-
