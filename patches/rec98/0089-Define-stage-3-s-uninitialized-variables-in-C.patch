-public _stones_ring_phase
-_stones_ring_phase	db ?
-public _stones_ring_i
-_stones_ring_i	db ?
-public _stones_ring_done
-_stones_ring_done	db ?
-		db ?
-public _stones_ring_tile_1
-_stones_ring_tile_1	dw ?
-public _stones_ring_tile_2
-_stones_ring_tile_2	dw ?
-public _stones_ring_tile_3
-_stones_ring_tile_3	dw ?
 
 		end
