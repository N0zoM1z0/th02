+int pascal near sigma_circle_add(
+	screen_x_t center_x, screen_y_t center_y, pixel_t radius_max
+)
+{
+	sigma_circle_t *p;
+	register int i;
+
+	p = sigma_circles;
+	if(
+		(center_x > 0) && (center_x < 444) &&
+		(center_y > 0) && (center_y < 400)
+	) {
+		for(i = 0; i < SIGMA_CIRCLE_COUNT; (i++, p++)) {
+			if(p->flag != 0) {
+				continue;
+			}
+			p->flag = 1;
+			p->frame = 0;
+			p->center_x = center_x;
+			p->center_y = center_y;
+			p->radius_max = radius_max;
+			p->cel = 26;
+			p->radius = 64;
+			snd_se_play(9);
+			return 0;
+		}
+	}
+	return 1;
+}
