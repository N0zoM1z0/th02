+void near sigma_circles_advance(void)
+{
+	sigma_circle_t *p;
+	int i;
+
+	p = sigma_circles;
+	for(i = 0; i < SIGMA_CIRCLE_COUNT; (i++, p++)) {
+		if(p->flag == 2) {
+			p->flag++;
+		}
+	}
