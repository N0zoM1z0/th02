+#define sigma_phase_start(f0, f1) { \
+	sigma_pattern = 0; \
+	boss_phase_frame = 0; \
+	sigma_phase++; \
+	sigma_patterns_done = false; \
+	sigma_pattern_funcs[0] = f0; \
+	sigma_pattern_funcs[1] = f1; \
+}
