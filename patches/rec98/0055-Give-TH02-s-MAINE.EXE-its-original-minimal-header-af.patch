 local zun_stub = pipeline_stub_cfg:stub("Pipeline/zun_stub.asm")
 local cstmstub = pipeline_stub_cfg:stub("Pipeline/cstmstub.asm")
 
@@ -575,7 +577,8 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/mima.cpp",
 	"th02/marisa.cpp",
 })
-th02:branch(MODEL_LARGE, { cflags = "-DBINARY='E'" }):link("maine", {
+-- TH02's MAINE.EXE got a minimal header after linking.
+local th02_maine_tlink = th02:branch(MODEL_LARGE, { cflags = "-DBINARY='E'" }):link("maine", {
 	{ "th02/end.cpp", extra_inputs = th02_sprites["verdict"] },
 	"th02_maine.asm",
 	"th02/grppsafx.cpp",
@@ -599,7 +602,13 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='E'" }):link("maine", {
 	"th02/maine_03.cpp",
 	"th02/maine_04.cpp",
 	"th02/staff.cpp",
-})
+}, "obj/th02/")
+Rules:add_16(
