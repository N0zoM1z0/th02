From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: N0zoM1z0 <161784452+N0zoM1z0@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:26:37 +0100
Subject: [PATCH] Define the high score TU's uninitialized variables in C++

---
 th02/regist_m.cpp |  7 +++++++
 th02_main.asm     | 33 ---------------------------------
 2 files changed, 7 insertions(+), 33 deletions(-)

diff --git a/th02/regist_m.cpp b/th02/regist_m.cpp
index 8c5d0654..c78f952a 100644
--- a/th02/regist_m.cpp
+++ b/th02/regist_m.cpp
@@ -11,6 +11,13 @@ struct extra_clear_flags_t {
 	uint8_t v[SHOTTYPE_COUNT];
 };
 
+// Uninitialized data, in the original order
+#pragma option -a2
+score_t hiscore;
+uint8_t hiscore_continues;
+scoredat_section_t hi;
+#pragma option -a-
+
 // Data, in the original order
 // ---------------------------
 
diff --git a/th02_main.asm b/th02_main.asm
index 5cdfec93..1d8ee9fe 100644
--- a/th02_main.asm
+++ b/th02_main.asm
@@ -1163,38 +1163,5 @@ public _meira_phase
 _meira_phase	db ?
 public _meira_pattern
 _meira_pattern	db ?
-public _hiscore, _hiscore_continues
-_hiscore	dd ?
-_hiscore_continues	db ?
-		db ?
-
-SCOREDAT_PLACES = 10
-SCOREDAT_NAME_LEN = 6
-
-date struc
-	da_year	dw ?
-	da_day 	db ?
-	da_mon 	db ?
-date ends
-
-scoredat_t struc
-	SCOREDAT_cleared         	dw ?
-	SCOREDAT_score           	dd SCOREDAT_PLACES dup(?)
-	SCOREDAT_score_sum       	dd ?
-	SCOREDAT_g_name          	db SCOREDAT_PLACES dup((SCOREDAT_NAME_LEN + 1) dup(?))
-	SCOREDAT_g_name_first_sum	db ?
-	SCOREDAT_stage           	db SCOREDAT_PLACES dup(?)
-	SCOREDAT_stage_sum       	db ?
-	SCOREDAT_date            	date SCOREDAT_PLACES dup(<?>)
-	SCOREDAT_shottype        	db SCOREDAT_PLACES dup(?)
-scoredat_t ends
-
-scoredat_section_t struc
-	SCORESECT_score      	scoredat_t <?>
-	SCORESECT_section_sum	dd ?
-scoredat_section_t ends
-
-public _hi
-_hi	scoredat_section_t <?>
 
 		end
