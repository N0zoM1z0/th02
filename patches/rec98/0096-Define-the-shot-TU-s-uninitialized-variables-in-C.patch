 	PLAYER_NOT_HIT = false,
 	PLAYER_HIT = true,
 	PLAYER_HIT_GAMEOVER = 0xFF,
-} player_is_hit;
+};
+extern player_hit_t player_is_hit;
 #else
 extern bool player_is_hit;
 #endif
diff --git a/th02/main/player/shot.cpp b/th02/main/player/shot.cpp
