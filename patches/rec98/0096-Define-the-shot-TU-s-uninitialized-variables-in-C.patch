+// Uninitialized data, in the original order
+// -----------------------------------------
+
+pixel_length_8_t scroll_speed;
+uint8_t scroll_cycle;
+vram_y_t scroll_line;
+int scroll_unused;
+vram_offset_t scroll_line_vo;
+int tile_rows_scrolled;
