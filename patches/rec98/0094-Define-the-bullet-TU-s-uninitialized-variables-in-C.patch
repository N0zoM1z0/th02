-extern bullet_t bullets[BULLET_COUNT];
+#pragma option -a2
 
-extern screen_x_t screen_left;
-extern screen_y_t screen_top;
-extern Subpixel8 rank_base_speed;
+// Uninitialized data, in the original order. The sparks are defined here, as
+// they are initialized together with the bullets.
+bullet_t bullets[BULLET_COUNT];
+spark_t sparks[SPARK_COUNT];
+screen_x_t screen_left;
+screen_y_t screen_top;
+bullet_special_t bullet_special;
+Subpixel8 rank_base_speed;
+uint8_t spark_sprite_interval;
+uint8_t spark_age_max;
 
 // ZUN bloat: Could have been local variables.
-extern Subpixel near* cur_left;
-extern Subpixel near* cur_top;
+Subpixel near* cur_left;
+Subpixel near* cur_top;
 
-extern uint8_t rank_base_stack;
-extern uint8_t stack;
-extern int8_t easy_slow_skip_cycle;
+uint8_t rank_base_stack;
+int8_t easy_slow_skip_cycle;
+uint8_t stack;
