diff --git a/th02/main/bullet/bullet.cpp b/th02/main/bullet/bullet.cpp
index 0daa1933..84d5b528 100644
--- a/th02/main/bullet/bullet.cpp
+++ b/th02/main/bullet/bullet.cpp
