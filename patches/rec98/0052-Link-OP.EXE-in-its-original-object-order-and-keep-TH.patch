From: N0zoM1z0 <161784452+N0zoM1z0@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:26:45 +0100
Subject: [PATCH] Link OP.EXE in its original object order, and keep TH02's
 nopcalls as far calls

OP.EXE is now identical to the original as a whole file. Its master.lib
relocations follow op_01's, and pfint21 moves after pi_load. The header
size depends on how many far fixups TLINK sees before shortening them:
in the original, master.lib's calls into other library objects were far
calls, so TH02's nopcall now emits one (under NOSMART) for TLINK to
shorten.
---
 ReC98.inc   | 12 ++++++++++++
 Tupfile.lua |  3 ++-
 th02_op.asm |  8 ++++----
 3 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/ReC98.inc b/ReC98.inc
index 865b89e9..087ace9f 100644
--- a/ReC98.inc
+++ b/ReC98.inc
@@ -20,6 +20,18 @@ include th02/formats/pi_slots.inc
 
 nopcall macro func
 if LDATA
+ifdef GAME
+if GAME eq 2
+	; In TH02, these were far calls into other objects, which TLINK shortened
+	; to NOP / PUSH CS / CALL near. Emitting the far call keeps the fixup that
+	; TLINK counts when sizing the EXE header. NOSMART stops TASM from
+	; shortening it on its own.
+	nosmart
+	call	far ptr func
+	smart
+	exitm
+endif
+endif
 	nop	; PC-98 Touhou compatibility
 endif
 	call func
diff --git a/Tupfile.lua b/Tupfile.lua
index 75467cb8..88da7ba0 100644
--- a/Tupfile.lua
+++ b/Tupfile.lua
@@ -479,12 +479,13 @@ th02:zungen("bin/th02/zun.com", {
 })
 th02:branch(MODEL_LARGE, { cflags = "-DBINARY='O'" }):link("op", {
 	"th02/op_01.cpp",
+	"th02_op.asm",
 	"th02/exit_dos.cpp",
 	"th02/zunerror.cpp",
 	"th02/grppsafx.cpp",
-	"th02_op.asm",
 	"th01/vplanset.cpp",
 	"th02/pi_load.cpp",
+	"th02/main/pf.asm",
 	"th02/grp_rect.cpp",
 	"th02/frmdely2.cpp",
 	"th02/input_rs.cpp",
diff --git a/th02_op.asm b/th02_op.asm
index e61b88a8..38f89c94 100644
--- a/th02_op.asm
+++ b/th02_op.asm
@@ -112,10 +112,10 @@ include libs/master.lib/super_cancel_pat.asm
 include libs/master.lib/super_put_rect.asm
 		db 0
 include libs/master.lib/super_put.asm
-include libs/master.lib/pfint21.asm
-		db 0
-include th02/formats/pfopen.asm
-include libs/master.lib/pf_str_ieq.asm
+
+	public parfilename, pfint21_pf, pfint21_handle, pferrno, pfkey, pf_limit
+	public mem_AllocID
+	extrn PFOPEN:far, PFSTART:far, PFEND:far
 _TEXT		ends
 
 ; ===========================================================================
