-	extrn _byte_1EB88:byte
 	extrn _stage_frame:dword
 	extrn _score_delta:dword
+	extrn _shots:byte
+public _SHOT_DAMAGE, _OPTION_SHOT_DAMAGE, _SHOT_DAMAGE_BIG
