+public _byte_1EB88
+_byte_1EB88	db 1
 _DATA	ends
 
 DGROUP group _DATA
@@ -52,11 +59,11 @@ arg_6		= word ptr  0Ah
 		mov	bl, _shot_level
 		mov	bh, 0
 		add	bx, bx
-		mov	ax, [bx+10DAh]
+		mov	ax, _SHOT_DAMAGE[bx]
 		mov	[bp+var_E], ax
-		mov	ax, [bx+10EEh]
+		mov	ax, _OPTION_SHOT_DAMAGE[bx]
 		mov	[bp+var_10], ax
-		mov	ax, [bx+1102h]
+		mov	ax, _SHOT_DAMAGE_BIG[bx]
 		mov	[bp+var_12], ax
 		mov	[bp+var_8], 0
 		mov	ax, [bp+arg_6]
@@ -70,7 +77,7 @@ arg_6		= word ptr  0Ah
 		add	ax, 0FFF8h
 		mov	[bp+var_6], ax
 		sub	[bp+arg_6], 8
-		mov	si, 2908h
+		mov	si, offset _shots
 		mov	[bp+var_2], 0
 
