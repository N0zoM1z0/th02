Subject: [PATCH] Decompile the stage 4 background sub_19E2F

---
 th02/main/boss/marisa.cpp | 47 +++++++++++++++++++++++
 th02/main_03_.asm         | 78 +--------------------------------------
 th02_main.asm             |  4 +-
 3 files changed, 50 insertions(+), 79 deletions(-)

diff --git a/th02/main/boss/marisa.cpp b/th02/main/boss/marisa.cpp
index b81ab5f2..6670532d 100644
--- a/th02/main/boss/marisa.cpp
+++ b/th02/main/boss/marisa.cpp
@@ -28,6 +28,7 @@
 #include "th02/main/spark.hpp"
 #include "th02/main/item/item.hpp"
 #include "planar.h"
+#include "decomp.hpp"
 #include "th02/hardware/frmdelay.h"
 #include "th02/main/tile/tile.hpp"
 #include "th02/main/scroll.hpp"
@@ -114,6 +115,52 @@ void shots_clear(void);
 
 extern vram_offset_t scroll_line_vo;
 
+// Background
+// ----------
+
+extern vram_y_t word_26D54;
+
+void sub_19E2F(void)
+{
+	register screen_x_t left;
+	register int image;
+	int tile_image;
+	vram_y_t top;
+
+	if(page_back == 0) {
+		egc_on();
+		outport2(EGC_ACTIVEPLANEREG, 0xFFF7);
+		outport2(EGC_READPLANEREG, 0x3FF);
+		outport2(EGC_MASKREG, 0xFFFF);
+		outport2(EGC_ADDRRESSREG, 0);
+		outport2(EGC_BITLENGTHREG, 0xF);
+		outport2(EGC_MODE_ROP_REG, (EGC_WS_PATREG + EGC_RL_MEMREAD));
+		tiles_invalidate_rect(176, 156, 96, 96);
+		tiles_egc_render();
+		outport2(EGC_MODE_ROP_REG, (EGC_WS_ROP + 0xFC));
+		word_26D54 = 152;
+		word_26D54 += scroll_line;
+		if(word_26D54 >= RES_Y) {
+			word_26D54 -= RES_Y;
+		}
+		top = word_26D54;
+		for(tile_image = 0; tile_image < 0x60; tile_image += 16) {
+			for(
+				left = 176, image = tile_image;
+				left < 272;
+				left += TILE_W, image++
+			) {
+				tile_egc_roll_copy_8(left, top, image);
+			}
+			top += TILE_H;
+			if(top >= RES_Y) {
+				top -= RES_Y;
+			}
+		}
+		egc_off();
+	}
+}
+
 // Midboss
 // -------
 
diff --git a/th02/main_03_.asm b/th02/main_03_.asm
index d647fe19..0ee00f0c 100644
--- a/th02/main_03_.asm
+++ b/th02/main_03_.asm
@@ -67,7 +67,7 @@ TM_NONE = 2
 	extrn _midboss4_bullet_top:word
 	extrn _midboss4_kill_frame:word
 	extrn _word_26CFE:word
-	extrn word_26D54:word
+	extrn _word_26D54:word
 	extrn _midboss4_active:word
 	extrn _bombs:byte
 	extrn _boss_left_on_back_page:word
@@ -537,82 +537,6 @@ loc_19E2A:
 @mima_end$qv	endp
 
 
-; =============== S U B	R O U T	I N E =======================================
-
-; Attributes: bp-based frame
-
-public @sub_19E2F$qv
-@sub_19E2F$qv	proc far
-
-@@top       	= word ptr -4
-@@tile_image	= word ptr -2
-
-		push	bp
-		mov	bp, sp
-		sub	sp, 4
-		push	si
-		push	di
-		cmp	_page_back, 0
-		jnz	loc_19EEF
-		call	egc_on
-		outw2	EGC_ACTIVEPLANEREG, 0FFF7h
-		outw2	EGC_READPLANEREG, 3FFh
-		outw2	EGC_MASKREG, 0FFFFh
-		outw2	EGC_ADDRRESSREG, 0
-		outw2	EGC_BITLENGTHREG, 0Fh
-		outw2	EGC_MODE_ROP_REG, (EGC_WS_PATREG or EGC_RL_MEMREAD)
-		call	@tiles_invalidate_rect$qiiii pascal, (176 shl 16) or 156, (96 shl 16) or 96
-		call	@tiles_egc_render$qv
-		outw2	EGC_MODE_ROP_REG, (EGC_WS_ROP or 0FCh)
-		mov	word_26D54, 152
-		mov	ax, _scroll_line
-		add	word_26D54, ax
-		cmp	word_26D54, RES_Y
-		jl	short loc_19EA7
-		sub	word_26D54, RES_Y
-
-loc_19EA7:
-		mov	ax, word_26D54
-		mov	[bp+@@top], ax
-		mov	[bp+@@tile_image], 0
-		jmp	short loc_19EE4
-; ---------------------------------------------------------------------------
-
-loc_19EB4:
-		mov	si, 176
-		mov	di, [bp+@@tile_image]
-		jmp	short loc_19ECA
-; ---------------------------------------------------------------------------
-
-loc_19EBC:
-		call	@tile_egc_roll_copy_8$qiii pascal, si, [bp+@@top], di
-		add	si, TILE_W
-		inc	di
-
-loc_19ECA:
-		cmp	si, 272
-		jl	short loc_19EBC
-		add	[bp+@@top], TILE_H
-		cmp	[bp+@@top], RES_Y
-		jl	short loc_19EE0
-		sub	[bp+@@top], RES_Y
-
-loc_19EE0:
-		add	[bp+@@tile_image], 10h
-
-loc_19EE4:
-		cmp	[bp+@@tile_image], 60h
-		jl	short loc_19EB4
-		call	egc_off
-
-loc_19EEF:
-		pop	di
-		pop	si
-		leave
-		retf
-@sub_19E2F$qv	endp
-
-
 main_03_TEXT	ends
 
 	end
