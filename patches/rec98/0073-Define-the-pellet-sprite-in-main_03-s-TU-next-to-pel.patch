From: N0zoM1z0 <161784452+N0zoM1z0@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:15:54 +0100
Subject: [PATCH] Define the pellet sprite in main_03's TU, next to
 pellet_render()

---
 Tupfile.lua                   | 10 ++++++----
 th02/main/bullet/pellet_r.cpp |  5 +++--
 th02_main.asm                 |  1 -
 3 files changed, 9 insertions(+), 7 deletions(-)

diff --git a/Tupfile.lua b/Tupfile.lua
index 44a05984..5347f3f2 100644
--- a/Tupfile.lua
+++ b/Tupfile.lua
@@ -466,6 +466,10 @@ local th02_sprites = Sprites({
 	{ "th02/sprites/verdict.bmp", "cpp", "sVERDICT_MASKS", 16, 16 },
 })
 
+local th02_pellet_sprite = BMP({
+	"th02/sprites/pellet.bmp", "cpp", "sPELLET", 8, 8, "-pshf outer"
+})
+
 local th02_spark_sprites = {
 	BMP({ "th02/sprites/bombpart.bmp", "cpp", "sBOMB_PARTICLES", 8, 8 }),
 	BMP({ "th02/sprites/sparks.bmp", "cpp", "sSPARKS", 8, 8, "-pshf outer" }),
@@ -517,9 +521,7 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='O'" }):link("op", {
 th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/main_seg.asm",
 	"th02/main_01a.cpp",
-	{ "th02_main.asm", extra_inputs = {
-		th02_sprites["pellet"],
-	} },
+	"th02_main.asm",
 	"th02/zunerror.cpp",
 	"th02/keydelay.cpp",
 	"th02/main02_1.cpp",
@@ -546,7 +548,7 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/snd_se.cpp",
 	"th02/main_rr.cpp",
 	"th02/main_cfg.cpp",
-	"th02/main_03.cpp",
+	{ "th02/main_03.cpp", extra_inputs = th02_pellet_sprite },
 	"th02/hud_ovrl.cpp",
 	"th02/main_01c.cpp",
 	"th02/main_01d.cpp",
diff --git a/th02/main/bullet/pellet_r.cpp b/th02/main/bullet/pellet_r.cpp
index ee24d4c1..be3b69b9 100644
--- a/th02/main/bullet/pellet_r.cpp
+++ b/th02/main/bullet/pellet_r.cpp
@@ -1,14 +1,15 @@
 #include "planar.h"
 #include "th01/sprites/pellet.h"
 
-extern const dots16_t sPELLET[PELLET_CELS][PRESHIFT][PELLET_H];
+// Defined in this TU, ahead of the code. Only one cel in TH02.
+#include "th02/sprites/pellet.csp"
 
 void pascal near pellet_render(screen_x_t left, vram_y_t top)
 {
 	_ES = SEG_PLANE_B;
 	_BX = _BX; // Keeps any parameters from being put into BX
 	_DI = vram_offset_shift_fast(left, top);
-	_SI = reinterpret_cast<uint16_t>(sPELLET[0][left & BYTE_MASK]);
+	_SI = reinterpret_cast<uint16_t>(sPELLET[left & BYTE_MASK][0].row);
 	_CX = PELLET_H;
 	put_loop: {
 		asm { movsw; }
diff --git a/th02_main.asm b/th02_main.asm
index f19fb1bd..c17be241 100644
--- a/th02_main.asm
+++ b/th02_main.asm
@@ -606,7 +606,6 @@ _rank	db RANK_NORMAL
 _stage_id	db 0
 public _aHuuma_cfg
 _aHuuma_cfg	db 'huuma.cfg',0
-include th02/sprites/pellet.asp
 
 
 
