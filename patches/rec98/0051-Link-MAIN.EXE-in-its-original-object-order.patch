 th02/main_01a.cpp       |  77 +++++++++++----
 th02/main_dtl.asm       |  78 +++++++++++++++
 th02/main_seg.asm       |  43 +++++++++
 th02/regist_m.cpp       |  31 +++++-
 th02_main.asm           | 205 +++++++++-------------------------------
 7 files changed, 293 insertions(+), 203 deletions(-)
 create mode 100644 th02/main_dtl.asm
 create mode 100644 th02/main_seg.asm

