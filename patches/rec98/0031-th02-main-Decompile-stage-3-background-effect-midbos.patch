 th02/main/boss/stones.cpp  | 1047 ------------------------------------
 th02/main/midboss/m3.cpp   |  363 ++++++++++++-
 th02/stage3.cpp            |   53 ++
 th02_main.asm              |  970 +--------------------------------
 7 files changed, 1432 insertions(+), 2011 deletions(-)
 delete mode 100644 th02/main/boss/stones.cpp
 create mode 100644 th02/stage3.cpp

