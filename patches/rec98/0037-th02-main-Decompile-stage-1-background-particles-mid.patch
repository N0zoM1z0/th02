@@ -557,6 +557,7 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/hud_ovrl.cpp",
 	"th02/bullet.cpp",
 	"th02/dialog.cpp",
