 th02/main/boss/rika.cpp |  666 ++++++++++++++++++++
 th02_main.asm           | 1302 +--------------------------------------
 3 files changed, 700 insertions(+), 1269 deletions(-)
 create mode 100644 th02/main/boss/rika.cpp

