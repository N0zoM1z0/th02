+		g_BAR_MAX_0, g_BAR_MAX_1, g_BAR_MAX_2, g_BAR_MAX_3, g_BAR_MAX_4, 0
+	};
+	const struct hack_colors COLORS = {
+		TX_RED, TX_RED, TX_RED, TX_MAGENTA, TX_MAGENTA,
+		TX_BLUE, TX_GREEN, TX_CYAN, TX_YELLOW,
+	};
+	struct hack_bar g_buf = { gb_SP, gb_SP, gb_SP, gb_SP, gb_SP, 0 };
 
 	shot_level = POWER_TO_SHOT_LEVEL[power >> SHOT_LEVEL_INTERVAL_BITS];
 	if(shot_level == SHOT_LEVEL_MAX) {
@@ -118,6 +138,19 @@ void near player_shot_level_update_and_hud_power_put(void)
 	gaiji_putsa(HUD_LABELED_LEFT, HUD_POWER_Y, g_buf.x, COLORS.x[shot_level]);
 }
 
+gaiji_th02_t gRANKS[RANK_COUNT][8] = {
+	{ gb_E, gb_A, gb_S, gb_Y, gb_SP, gb_SP, gb_SP, gs_NULL },
+	{ gb_N, gb_O, gb_R, gb_M, gb_A, gb_L, gb_SP, gs_NULL },
+	{ gb_H, gb_A, gb_R, gb_D, gb_SP, gb_SP, gb_SP, gs_NULL },
