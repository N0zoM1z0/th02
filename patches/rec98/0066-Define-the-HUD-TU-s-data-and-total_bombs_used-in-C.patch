+int32_t SEVEN_DIGIT_POWERS_OF_10[SCORE_DIGITS - 1] = {
+	1000000, 100000, 10000, 1000, 100, 10, 1
+};
 
 // Only prints the seven score digits, in contrast to the TH04/TH05 version!
