+	{ gb_E, gb_X, gb_T, gb_R, gb_A, gb_SP, gb_SP, gs_NULL },
+};
+gaiji_th02_t gsSCORE[5] = { gs_Sc, gs_cor, gs_e };
+gaiji_th02_t gsHISCORE[5] = { gs_Hi, gs_Sc, gs_cor, gs_e };
+gaiji_th02_t gsREIMU[5] = { gs_REIMU_REI, gs_REIMU_MU };
+gaiji_th02_t gsREIGEKI[5] = { gs_REIGEKI_REI, gs_REIGEKI_GEKI };
+gaiji_th02_t gsREIRYOKU[5] = { gs_REIRYOKU_REI, gs_REIRYOKU_RYOKU };
+
 #define hud_gaiji_tally_put(y, value, gaiji) { \
 	/** \
 	 * ZUN landmine: No check for values > HUD_LABELED_GAIJI_W. These will \
