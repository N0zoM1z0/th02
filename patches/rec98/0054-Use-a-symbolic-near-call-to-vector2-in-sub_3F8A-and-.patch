From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: N0zoM1z0 <161784452+N0zoM1z0@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:32:55 +0100
Subject: [PATCH] Use a symbolic near call to vector2() in sub_3F8A(), and
 document shots_hittest() as ZUN's assembly

---
 th02/main/dots_upd.asm | 14 ++++++--------
 th02/main/hittest.asm  | 11 ++++++-----
 2 files changed, 12 insertions(+), 13 deletions(-)

diff --git a/th02/main/dots_upd.asm b/th02/main/dots_upd.asm
index 424bf5ac..1bfda713 100644
--- a/th02/main/dots_upd.asm
+++ b/th02/main/dots_upd.asm
@@ -2,10 +2,10 @@
 ; -----
 ; The update and render function for TH02's dots, split out of th02_main.asm
 ; after the rest of their code was decompiled into th02/main/dots.cpp.
-; In the original binary, its far call to vector2() in the SHARED segment was
-; turned into PUSH CS / CALL near, which TLINK 6.10 only does for calls within
-; one physical segment. A natural C++ call therefore produces a far CALL and
-; an extra relocation, and the original instruction bytes are kept here.
+; Its call to vector2() in SHARED is PUSH CS / CALL near, with a near fixup that
+; TLINK resolves relative to _TEXT's frame 0. TLINK 6.10 never shortens a far
+; call across physical segments, so a natural C++ call would give a far CALL
+; with an extra relocation.
 
 	.386
 	locals
@@ -33,6 +33,7 @@ _TEXT	segment	byte public 'CODE' use16
 	extrn GRCG_SETCOLOR:far
 	extrn GRCG_OFF:far
 	extrn @CIRCLE_DOT_PUT$QI:far
+	extrn @VECTOR2$QMIT1UCI:near
 
 public @sub_3F8A$qv
 @sub_3F8A$qv	proc far
@@ -87,10 +88,7 @@ loc_3FC1:
 		push	ax
 		nop
 		push	cs
-		; Hack (what is this I don't even)
-		db 0e8h
-		db 075h
-		db 0b5h
+		call	near ptr @VECTOR2$QMIT1UCI
 		mov	al, _page_back
 		mov	ah, 0
 		shl	ax, 2
diff --git a/th02/main/hittest.asm b/th02/main/hittest.asm
index d02ff69f..ee70b7ae 100644
--- a/th02/main/hittest.asm
+++ b/th02/main/hittest.asm
@@ -1,10 +1,11 @@
 ; ReC98
 ; -----
-; TH02's shot hit testing, split out of th02_main.asm so that the code before
-; it can be decompiled. Unlike its neighbors, ZUN compiled it for the 80286
-; (-2): long conditional branches are short inverted jumps over a near JMP.
-; A C++ version matches except for the final reload of [damage] before
-; returning.
+; TH02's shot hit testing, ZUN's own assembly module. In the original, its
+; relocations are listed in ascending order (TASM), unlike every TCC object
+; around it, and the module's code segment is word-aligned, which TCC never
+; emits. The code itself is TCC output for the 80286 (inverted short jumps
+; over near JMPs), with a 16-bit `add` into the 32-bit [score_delta] at the
+; end.
 
 	.386
 	locals
