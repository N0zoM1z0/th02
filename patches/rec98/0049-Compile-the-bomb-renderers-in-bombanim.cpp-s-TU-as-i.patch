From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: N0zoM1z0 <161784452+N0zoM1z0@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:12:50 +0100
Subject: [PATCH] Compile the bomb renderers in bombanim.cpp's TU, as in the
 original

---
 Tupfile.lua                   |  1 -
 th02/main/player/bomb.cpp     | 12 +-----------
 th02/main/player/bombanim.cpp |  6 ++++++
 th02/player_b.cpp             |  1 -
 4 files changed, 7 insertions(+), 13 deletions(-)
 delete mode 100644 th02/player_b.cpp

diff --git a/Tupfile.lua b/Tupfile.lua
index b8b4d9c3..c253eb05 100644
--- a/Tupfile.lua
+++ b/Tupfile.lua
@@ -529,7 +529,6 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/item.cpp",
 	"th02/hud.cpp",
 	"th02/main/player/bombanim.cpp",
-	"th02/player_b.cpp",
 	"th02/player.cpp",
 	"th02/zunerror.cpp",
 	"th02/keydelay.cpp",
diff --git a/th02/main/player/bomb.cpp b/th02/main/player/bomb.cpp
index 9e76eef3..e4a2383c 100644
--- a/th02/main/player/bomb.cpp
+++ b/th02/main/player/bomb.cpp
@@ -1,11 +1,5 @@
-#pragma option -zCmain_01_TEXT
-#include "libs/master.lib/pc98_gfx.hpp"
+// Included at the end of th02/main/player/bombanim.cpp, in the same TU.
 #include "th01/math/overlap.hpp"
-#include "th02/main/playfld.hpp"
-#include "th02/main/scroll.hpp"
-#include "th02/main/tile/tile.hpp"
-#include "th02/main/player/player.hpp"
-#include "th02/main/player/bomb.hpp"
 #include "th02/sprites/bombpart.h"
 
 extern int bomb_frame;
@@ -31,10 +25,6 @@ void pascal near bomb_bft_8tiles_put_8(
 void near bomb_circle_update_and_render(void)
 ;
 
-void pascal near bomb_reimu_a(void);
-void pascal near bomb_reimu_c(void);
-void pascal near bomb_reimu_b(void);
-
 void near bomb_update_and_render(void)
 {
 	bool16 done = false;
diff --git a/th02/main/player/bombanim.cpp b/th02/main/player/bombanim.cpp
index 68e09edb..fbd44ad4 100644
--- a/th02/main/player/bombanim.cpp
+++ b/th02/main/player/bombanim.cpp
@@ -532,3 +532,9 @@ extern "C" bool16 pascal near bomb_reimu_b(void)
 	grcg_off();
 	return false;
 }
+
+// The bomb renderers follow in the same TU (one LEDATA chunk spans the
+// boundary), compiled without -G.
+#pragma option -G-
+
+#include "th02/main/player/bomb.cpp"
diff --git a/th02/player_b.cpp b/th02/player_b.cpp
deleted file mode 100644
index e4c65151..00000000
--- a/th02/player_b.cpp
+++ /dev/null
@@ -1 +0,0 @@
-#include "th02/main/player/bomb.cpp"
