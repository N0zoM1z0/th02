+
+// Uninitialized data
+score_t score_delta;
+unsigned int score_delta_transferred_prev;
+uint8_t shot_level;
 // ---------------------------
 
 // Gaiji strings
diff --git a/th02/main/score.cpp b/th02/main/score.cpp
index dbba33e4..fcf0e3b9 100644
--- a/th02/main/score.cpp
+++ b/th02/main/score.cpp
@@ -5,7 +5,6 @@
 
 // Amount of points transferred from [score_delta] to [score] during the
