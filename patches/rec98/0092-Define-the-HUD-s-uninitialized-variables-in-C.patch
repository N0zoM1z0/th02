-extern unsigned int score_delta_transferred_prev;
 // -----
 
 void near score_extend_init(void)
diff --git a/th02_main.asm b/th02_main.asm
index 094a9882..9845441c 100644
--- a/th02_main.asm
+++ b/th02_main.asm
@@ -945,10 +945,5 @@ _item_collect_skill	db ?
 		db ?
 _item_frame_unused	dw ?
 
-public _score_delta, _score_delta_transferred_prev, _shot_level
