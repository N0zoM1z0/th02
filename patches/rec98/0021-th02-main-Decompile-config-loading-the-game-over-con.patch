+struct shot_t {
+	uint8_t flag;
+	int8_t unknown[15];
+};
+
+static const int SHOT_COUNT = 38;
+
+extern shot_t shots[SHOT_COUNT];
+extern uint8_t byte_205DE;
+extern uint8_t byte_205DF;
+extern uint8_t byte_205E0;
+extern uint8_t stage_miss_count;
+extern int word_205D8;
+extern int word_205DA;
+extern int word_205DC;
+extern uint8_t byte_20611;
+extern uint8_t byte_1E518;
+extern int8_t playchar_speed_aligned_x;
+extern int8_t playchar_speed_aligned_y;
+extern int8_t playchar_speed_diagonal_x;
+extern int8_t playchar_speed_diagonal_y;
+extern void (near *playchar_shot_func)(void);
+extern uint8_t shot_max_param_1;
+extern uint8_t shot_max_param_2;
+extern int8_t shot_max_spread;
+void near shot_a(void);
+void near shot_b(void);
+void near shot_c(void);
+
+void near sub_C5B0(void)
+{
+	int i;
+	for(i = 0; i < SHOT_COUNT; i++) {
+		shots[i].flag = 0;
+	}
+	byte_205DE = 0;
+	player_invincibility_time = 0;
+	player_invincible_via_bomb = false;
+	quit = false;
+	stage_miss_count = 0;
+	miss_frame = 0;
+	byte_205DF = 8;
+	byte_205E0 = 0;
+	player_is_hit = false;
+	miss_active = false;
+	player_option_patnum = PAT_OPTION_A;
+	word_205D8 = -1;
+	word_205DC = -1;
+	word_205DA = -1;
+	shot_max_spread = 0;
+	byte_20611 = 0;
+	switch(resident->shottype) {
+	case 0:
+		playchar_shot_func = shot_a;
+		playchar_speed_aligned_x = 5;
+		playchar_speed_aligned_y = 5;
+		playchar_speed_diagonal_x = 4;
+		playchar_speed_diagonal_y = 4;
+		shot_max_param_1 = 48;
+		break;
+	case 1:
+		playchar_shot_func = shot_b;
+		playchar_speed_aligned_x = 4;
+		playchar_speed_aligned_y = 4;
+		playchar_speed_diagonal_x = 3;
+		playchar_speed_diagonal_y = 3;
+		shot_max_param_1 = 52;
+		shot_max_param_2 = 55;
+		player_option_patnum++;
+		break;
+	case 2:
+		playchar_shot_func = shot_c;
+		playchar_speed_aligned_x = 3;
+		playchar_speed_aligned_y = 3;
+		playchar_speed_diagonal_x = 3;
+		playchar_speed_diagonal_y = 3;
+		byte_1E518 = 3;
+		shot_max_param_1 = 125;
+		shot_max_param_2 = 59;
+		player_option_patnum += 2;
+		break;
+	}
+}
+
+#pragma option -G
+
+void near sub_D38F(void);
+
+void near player_invalidate(void)
+{
+	int unused = 2;
+	screen_x_t option_left;
+
+	sub_D38F();
+	player_left_on_back_page = &player_left_on_page[page_back];
+	player_top_on_back_page = &player_top_on_page[page_back];
+	player_option_left_left_on_back_page = (
+		&player_option_left_topleft[page_back].x
+	);
+	player_option_left_top_on_back_page = (
+		&player_option_left_topleft[page_back].y
+	);
+	tiles_invalidate_rect(
+		*player_left_on_back_page, *player_top_on_back_page, PLAYER_W, PLAYER_H
+	);
+	option_left = *player_option_left_left_on_back_page;
+	tiles_invalidate_rect(
+		option_left,
+		*player_option_left_top_on_back_page,
+		PLAYER_OPTION_W,
+		PLAYER_OPTION_H
+	);
+	tiles_invalidate_rect(
+		(option_left + PLAYER_OPTION_TO_OPTION_DISTANCE),
+		*player_option_left_top_on_back_page,
+		PLAYER_OPTION_W,
+		PLAYER_OPTION_H
+	);
+	*player_left_on_back_page = player_left_on_page[page_front];
+	*player_top_on_back_page = player_top_on_page[page_front];
+}
