+extern const char aHuuma_cfg[];
+
+int near cfg_load(void)
+{
+	resident_t __seg *resident_seg;
+
+	file_ropen(aHuuma_cfg);
+	file_seek(5, 0);
+	file_read(&resident_seg, sizeof(resident_seg));
+	file_close();
+	if(resident_seg) {
+		resident = resident_seg;
+		stage_id = resident->stage;
+		lives = resident->start_lives;
+		bombs = resident->start_bombs;
+		rank = resident->rank;
+		power = resident->start_power;
+		if(power == 0) {
+			power++;
+		}
+		playperf = 0;
+		item_bigpower_override = 0;
+		return 1;
+	}
+	return 0;
+}
+
+extern const unsigned char gYES[];
+extern const unsigned char gNO[];
+extern const unsigned char gGAMEOVER[];
+extern const unsigned char gCONTINUE[];
+extern const unsigned char gCREDIT[];
+extern const char asc_1E47E[];
+
+void pascal near continue_choice_put(int yes_atrb, int no_atrb)
+{
+	gaiji_putsa(24, 14, gYES, yes_atrb);
+	gaiji_putsa(25, 15, gNO, no_atrb);
+}
+
+int near gameover_and_continue_menu(void)
+{
+	int input_state = 0;
+	int i;
+	int choice = 1;
+
+	asm { nop; push cs; call near ptr overlay_stage_leave_animate; }
+	PaletteTone = 50;
+	palette_show();
+	asm { nop; push cs; call near ptr overlay_stage_enter_animate; }
+	for(i = 21; i >= 12; i--) {
+		text_putsa(18, (i + 1), asc_1E47E, TX_WHITE);
+		gaiji_putsa(18, i, gGAMEOVER, TX_WHITE);
+		text_putsa(18, (23 - i), asc_1E47E, TX_WHITE);
+		gaiji_putsa(18, (24 - i), gGAMEOVER, TX_WHITE);
+		text_putsa((29 - i), 12, asc_1E47E, TX_WHITE);
+		gaiji_putsa((30 - i), 12, gGAMEOVER, TX_WHITE);
+		text_putsa((i + 7), 12, asc_1E47E, TX_WHITE);
+		gaiji_putsa((i + 6), 12, gGAMEOVER, TX_WHITE);
+		frame_delay(1);
+	}
+	frame_delay(30);
+	key_det = 0;
+	while(key_det == 0) {
+		input_reset_sense();
+	}
+	overlay_wipe();
+	regist_menu();
+	overlay_wipe();
+	if((resident->continues_used < 3) && (rank < RANK_EXTRA)) {
+		gaiji_putsa(18, 12, gCONTINUE, TX_WHITE);
+		continue_choice_put((TX_WHITE | TX_REVERSE), TX_WHITE);
+		gaiji_putsa(18, 20, gCREDIT, TX_GREEN);
+		i = (gb_3 - resident->continues_used);
+		gaiji_putca(32, 20, i, TX_GREEN);
+		choice = 1;
+		while(1) {
+			input_reset_sense();
+			if((input_state == 0) && (key_det == 0)) {
+				input_state = 1;
+			} else if((input_state == 1) && (key_det != 0)) {
+				input_state = 2;
+			}
+			if(key_det & INPUT_UP) {
+				choice = 1;
+				continue_choice_put((TX_WHITE | TX_REVERSE), TX_WHITE);
+			}
+			if(key_det & INPUT_DOWN) {
+				choice = 0;
+				continue_choice_put(TX_WHITE, (TX_WHITE | TX_REVERSE));
+			}
+			if((input_state == 2) && (
+				(key_det & INPUT_SHOT) ||
+				(key_det & INPUT_OK) ||
+				(key_det & INPUT_CANCEL)
+			)) {
+				break;
+			}
+			frame_delay(1);
+		}
+		if(key_det & INPUT_CANCEL) {
+			choice = 0;
+		}
+	} else {
+		choice = 0;
+	}
+	resident->score_highest = (resident->score_highest < score)
+		? score
+		: resident->score_highest;
+	lives = resident->start_lives;
+	bombs = resident->start_bombs;
+	power = POWER_MIN;
+	resident->continues_used++;
+	score_reset();
+	item_bigpower_override = ((stage_id % 5) + 2);
+	power_overflow = 10;
+	PaletteTone = 100;
+	palette_show();
+	overlay_wipe();
+	return choice;
+}
+
+void near sub_E24A(void);
+void stage_data_free(void);
+void near gaiji_free(void);
+void game_exit(void);
+
+int GameExecl(char *binary_fn)
+{
+	pi_free(0);
+	sub_E24A();
+	mpn_free();
+	stage_data_free();
+	super_free();
+	graph_clear();
+	text_clear();
+	gaiji_free();
+	game_exit();
+	return execl(binary_fn, binary_fn, NULL);
+}
