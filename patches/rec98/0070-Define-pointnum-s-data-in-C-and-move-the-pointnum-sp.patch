 POINTNUM_H = 8
 
 _DATA	segment word public 'DATA' use16
-	extrn _sPOINTNUMS:byte
+include th02/sprites/pointnum.asp
 _DATA	ends
 
 DGROUP group _DATA
diff --git a/th02/main/pointnum/pointnum.cpp b/th02/main/pointnum/pointnum.cpp
index f3a215e9..ef13bcfc 100644
--- a/th02/main/pointnum/pointnum.cpp
+++ b/th02/main/pointnum/pointnum.cpp
@@ -117,9 +117,10 @@ void near pointnums_invalidate(void)
 	}
 }
 
+uint16_t FOUR_DIGIT_POWERS_OF_10[POINTNUM_DIGITS] = { 1000, 100, 10, 1 };
+
 void pascal near pointnum_render(screen_x_t left, vram_y_t top, uint16_t points)
 {
-	extern uint16_t FOUR_DIGIT_POWERS_OF_10[POINTNUM_DIGITS];
 
 	int i;
 	bool past_leading_zeroes = false;
diff --git a/th02_main.asm b/th02_main.asm
index 7891ff95..2504e19f 100644
--- a/th02_main.asm
+++ b/th02_main.asm
@@ -635,9 +635,6 @@ include th02/gaiji/gameover[data].asm
 public _asc_1E47E
