 th02/main/pointnum/num_put_m.asm | 2 +-
 th02/main/pointnum/pointnum.cpp  | 3 ++-
 th02_main.asm                    | 3 ---
 4 files changed, 4 insertions(+), 7 deletions(-)

diff --git a/Tupfile.lua b/Tupfile.lua
index 8b87ad9c..44a05984 100644
--- a/Tupfile.lua
+++ b/Tupfile.lua
@@ -519,7 +519,6 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/main_01a.cpp",
 	{ "th02_main.asm", extra_inputs = {
 		th02_sprites["pellet"],
-		th02_sprites["pointnum"],
 	} },
 	"th02/zunerror.cpp",
 	"th02/keydelay.cpp",
@@ -553,7 +552,7 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/main_01d.cpp",
 	"th02/main_01e.cpp",
 	"th02/pointnum.cpp",
-	"th02/main/pointnum/num_put_m.asm",
+	{ "th02/main/pointnum/num_put_m.asm", extra_inputs = th02_sprites["pointnum"] },
 	"th02/main/player/shot.cpp",
 	"th02/main/boss/explode.cpp",
 	"th02/bullet.cpp",
diff --git a/th02/main/pointnum/num_put_m.asm b/th02/main/pointnum/num_put_m.asm
index 140ae265..2b3e652a 100644
