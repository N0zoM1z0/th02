diff --git a/planar.h b/planar.h
index a43a44a0..ff928808 100644
--- a/planar.h
+++ b/planar.h
@@ -74,7 +74,13 @@ template <class RowDots, pixel_t H> struct DotRect {
 
 // Since array subscripts create slightly different assembly in places, we
 // offer both variants.
+#if (GAME == 2)
+// TH02 defines the four planes as separate variables in this order, and only
+// ever accesses them as an array via the first one.
+#define VRAM_PLANE (&VRAM_PLANE_B)
+#else
 extern dots8_t far *VRAM_PLANE[PLANE_COUNT];
+#endif
 // And no, expressing these as a struct won't generate the same ASM.
 // Been there, tried that.
 extern dots8_t far *VRAM_PLANE_B;
