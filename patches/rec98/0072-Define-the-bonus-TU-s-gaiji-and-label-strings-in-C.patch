Subject: [PATCH] Define the bonus TU's gaiji and label strings in C++

---
 th02/main/stage/bonus.cpp |  7 +++++--
 th02/shiftjis/bonus.hpp   | 26 +++++++++++++-------------
 th02/shiftjis/bonus_d.hpp | 18 ++++++++++++++++++
 th02_main.asm             | 24 ------------------------
 4 files changed, 36 insertions(+), 39 deletions(-)
 create mode 100644 th02/shiftjis/bonus_d.hpp

diff --git a/th02/main/stage/bonus.cpp b/th02/main/stage/bonus.cpp
index b36481c5..3d21235b 100644
--- a/th02/main/stage/bonus.cpp
+++ b/th02/main/stage/bonus.cpp
@@ -24,6 +24,11 @@ struct hack {
 	char x[6]; // ACTUAL TYPE: gaiji_th02_t
 };
 
+struct hack gBONUS_0 = { gb_B, gb_O, gb_N, gb_U, gb_S, gs_NULL };
+struct hack gBONUS_1 = { gb_B, gb_O, gb_N, gb_U, gb_S, gs_NULL };
+
+#include "th02/shiftjis/bonus_d.hpp"
+
 inline void bonus_title_put(const struct hack& title) {
 	// ZUN bloat: Not `static`, gets needlessly copied into a local variable.
 	const struct hack gBONUS = title;
@@ -125,7 +130,6 @@ void near stage_clear_bonus_animate(void)
 	score_t bonus_total;
 	int sum = 0;
 
-	extern struct hack gBONUS_0;
 	bonus_title_put(gBONUS_0);
 
 	bonus_row_put_and_add(6, BONUS_RANK, sum, (rank * 2000));
@@ -163,7 +167,6 @@ void near stage_extra_clear_bonus_animate(void)
 	score_t bonus_total;
 	int sum = 0;
 
-	extern struct hack gBONUS_1;
 	bonus_title_put(gBONUS_1);
 
 	bonus_row_put_and_add(6, BONUS_EXTRA_CLEAR, sum, 10000);
