diff --git a/th02/main/mpn_put.cpp b/th02/main/mpn_put.cpp
new file mode 100644
index 00000000..3d376f76
--- /dev/null
+++ b/th02/main/mpn_put.cpp
@@ -0,0 +1,54 @@
+/* ReC98
+ * -----
+ * TH02's .MPN tile blitter, in _TEXT between master.lib's super_zoom() and
+ * pfint21.
+ */
+
+#pragma option -zC_TEXT -zPTEXT
+
+#include <stddef.h>
+#include "platform.h"
+#include "x86real.h"
+#include "pc98.h"
+#include "planar.h"
+#include "th02/formats/mpn.hpp"
+
+#define mpn_plane_word(offset) \
+	*reinterpret_cast<uint16_t near *>(_SI + offset)
+
+void pascal mpn_put_8(screen_x_t left, vram_y_t top, int image)
+{
+	asm { push ds; }
+
+	// ZUN bloat: Same as vram_offset_shift(left, top).
+	_DI = top;
+	_AX = (left >> BYTE_BITS);
+	_DX = _DI;
+	_DX <<= 6;
+	_AX += _DX;
+	_DX >>= 2;
+	_AX += _DX;
+	_DI = _AX;
+
+	_AX = (image * sizeof(mpn_image_t));
+	_DX = FP_SEG(mpn_images);
+	_BX = FP_OFF(mpn_images);
+	_BX += _AX;
+	_DS = _DX;
+	_SI = _BX;
+	_CX = TILE_H;
+	put_loop: {
+		_ES = SEG_PLANE_B;
+		_poke_(_ES, _DI, mpn_plane_word(offsetof(mpn_image_t, B)));
+		_ES = SEG_PLANE_R;
+		_poke_(_ES, _DI, mpn_plane_word(offsetof(mpn_image_t, R)));
+		_ES = SEG_PLANE_G;
+		_poke_(_ES, _DI, mpn_plane_word(offsetof(mpn_image_t, G)));
+		_ES = SEG_PLANE_E;
+		_poke_(_ES, _DI, mpn_plane_word(offsetof(mpn_image_t, E)));
+		_DI += ROW_SIZE;
+		_SI += (TILE_W / BYTE_DOTS);
+		asm { loop put_loop; }
+	}
+	asm { pop ds; }
+}
diff --git a/th02/main/pf.asm b/th02/main/pf.asm
new file mode 100644
index 00000000..eb91bbcd
--- /dev/null
+++ b/th02/main/pf.asm
@@ -0,0 +1,44 @@
+; ReC98
+; -----
+; master.lib's pfint21 and pf_str_ieq around TH02's modified pfopen(), split out
+; of th02_main.asm so that mpn_put_8() before them can be decompiled.
+
+	.386
+	.model use16 large _TEXT
+
+include ReC98.inc
+
+	.data
+	extrn parfilename:byte
+	extrn pfint21_pf:word
+	extrn pfint21_handle:word
+	extrn pferrno:word
+	extrn pfkey:byte
+	extrn pf_limit:byte
+	extrn mem_AllocID:word
+
+TEXT group _TEXT
+_TEXT	segment	word public 'CODE' use16
+	assume cs:TEXT
+	assume es:nothing, ds:_DATA, fs:nothing, gs:nothing
+	extrn BCLOSER:far
+	extrn BOPENR:far
+	extrn BREAD:far
+	extrn BSEEK_:far
+	extrn HMEM_ALLOCBYTE:far
+	extrn HMEM_FREE:far
+	extrn PFCLOSE:far
+	extrn PFREAD:far
+	extrn PFREWIND:far
+	extrn PFSEEK:far
+	extrn PFGETC1:near
+	extrn PFGETX1:near
+
+include libs/master.lib/pfint21.asm
+	db 0
+include th02/formats/pfopen.asm
+include libs/master.lib/pf_str_ieq.asm
+
+_TEXT	ends
+
+	end
