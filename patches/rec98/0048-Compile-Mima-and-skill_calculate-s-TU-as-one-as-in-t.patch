From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: N0zoM1z0 <161784452+N0zoM1z0@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:12:09 +0100
Subject: [PATCH] Compile Mima and skill_calculate()'s TU as one, as in the
 original

---
 Tupfile.lua            |  1 -
 th02/boss_5.cpp        |  9 ---------
 th02/main/boss/b5_.cpp | 15 +--------------
 th02/mima.cpp          | 10 ++++++++--
 4 files changed, 9 insertions(+), 26 deletions(-)
 delete mode 100644 th02/boss_5.cpp

diff --git a/Tupfile.lua b/Tupfile.lua
index 02e41bdd..b8b4d9c3 100644
--- a/Tupfile.lua
+++ b/Tupfile.lua
@@ -567,7 +567,6 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/main/boss/sigma.cpp",
 	"th02/main/enemy/enemy.cpp",
 	"th02/mima.cpp",
-	"th02/boss_5.cpp",
 	"th02/marisa.cpp",
 	"th02/regist_m.cpp",
 })
diff --git a/th02/boss_5.cpp b/th02/boss_5.cpp
deleted file mode 100644
index 3b27da34..00000000
--- a/th02/boss_5.cpp
+++ /dev/null
@@ -1,9 +0,0 @@
-/* ReC98
- * -----
- * skill_calculate() and the Stage 5 boss (Mima) intro and defeat code of TH02
- * MAIN.EXE. Compiled without -G: the KAJA fade call cleans its argument with
- * POP CX rather than ADD SP, 2.
- */
-
-#pragma option -zCmain_03_TEXT
-#include "th02/main/boss/b5_.cpp"
diff --git a/th02/main/boss/b5_.cpp b/th02/main/boss/b5_.cpp
index f27792df..d2acb8b3 100644
--- a/th02/main/boss/b5_.cpp
+++ b/th02/main/boss/b5_.cpp
@@ -1,20 +1,7 @@
-#include "platform.h"
-#include "pc98.h"
-#include "libs/master.lib/master.hpp"
-#include "libs/master.lib/pc98_gfx.hpp"
-#include "th02/resident.hpp"
-#include "th02/core/globals.hpp"
+// Included after th02/main/boss/mima.cpp, in the same TU.
 #include "th02/main/playperf.hpp"
-#include "th02/hardware/pages.hpp"
 #include "th02/hardware/frmdelay.h"
-#include "th02/main/playfld.hpp"
-#include "th02/main/boss/boss.hpp"
 #include "th02/main/dialog/dialog.hpp"
-#include "th02/main/bullet/bullet.hpp"
-#include "th02/main/player/player.hpp"
-#include "th02/main/tile/tile.hpp"
-#include "th02/snd/snd.h"
-#include "th02/sprites/main_pat.h"
 
 void near skill_calculate(void)
 {
diff --git a/th02/mima.cpp b/th02/mima.cpp
index dc631603..4ecf0ab0 100644
--- a/th02/mima.cpp
+++ b/th02/mima.cpp
@@ -1,9 +1,15 @@
 /* ReC98
  * -----
- * Stage 5 boss code (Mima) of TH02 MAIN.EXE, the first part of the segment shared
- * with skill_calculate()
+ * Stage 5 boss code (Mima) of TH02 MAIN.EXE, followed by skill_calculate()
+ * and Mima's intro and defeat code. One TU in the original: its relocations
+ * share a LEDATA chunk across the boundary. The second part is compiled
+ * without -G (the KAJA fade call cleans its argument with POP CX).
  */
 
 #pragma option -zCmain_03_TEXT -zPmain_03 -G -a2
 
 #include "th02/main/boss/mima.cpp"
+
+#pragma option -G-
+
+#include "th02/main/boss/b5_.cpp"
