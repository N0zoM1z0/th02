From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: N0zoM1z0 <161784452+N0zoM1z0@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:14 +0100
Subject: [PATCH] Define the spark TU's data in C++ and link it after the bomb
 code

The bomb particle and spark sprites and spark_accel_x follow the bomb
code's string literals in DGROUP, so they are the data of the spark TU,
whose position in the link is otherwise unconstrained. The sprites are
generated as C++ arrays by bmp2arr.
---
 Tupfile.lua               | 13 ++++++++-----
 th02/main/player/bomb.cpp |  2 +-
 th02/main/spark.cpp       | 12 +++++++++++-
 th02/sprites/bombpart.h   |  6 +++---
 th02/sprites/sparks.h     |  2 +-
 th02_main.asm             |  4 ----
 6 files changed, 24 insertions(+), 15 deletions(-)

diff --git a/Tupfile.lua b/Tupfile.lua
index 81295214..fcdabf7d 100644
--- a/Tupfile.lua
+++ b/Tupfile.lua
@@ -466,6 +466,11 @@ local th02_sprites = Sprites({
 	{ "th02/sprites/verdict.bmp", "cpp", "sVERDICT_MASKS", 16, 16 },
 })
 
+local th02_spark_sprites = {
+	BMP({ "th02/sprites/bombpart.bmp", "cpp", "sBOMB_PARTICLES", 8, 8 }),
+	BMP({ "th02/sprites/sparks.bmp", "cpp", "sSPARKS", 8, 8, "-pshf outer" }),
+}
+
 local th02_zuninit = th02:branch(MODEL_ASM):link("zuninit", {
 	"th02_zuninit.asm",
 })
@@ -514,8 +519,6 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/main_01a.cpp",
 	{ "th02_main.asm", extra_inputs = {
 		th02_sprites["pellet"],
-		th02_sprites["bombpart"],
-		th02_sprites["sparks"],
 		th02_sprites["pointnum"],
 	} },
 	"th02/zunerror.cpp",
@@ -528,9 +531,6 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/main/pf.asm",
 	"th02/main/dots.cpp",
 	"th02/main/dots_upd.asm",
-	"th02/spark.cpp",
-	"th02/spark_i.asm",
-	"th02/tile.cpp",
 	"th02/frmdely1.cpp",
 	"th02/input_rs.cpp",
 	"th02/exit.cpp",
@@ -561,6 +561,9 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/item.cpp",
 	"th02/hud.cpp",
 	"th02/main/player/bombanim.cpp",
+	{ "th02/spark.cpp", extra_inputs = th02_spark_sprites },
+	"th02/spark_i.asm",
+	"th02/tile.cpp",
 	"th02/main_04.cpp",
 	"th02/player.cpp",
 	"th02/stage3.cpp",
diff --git a/th02/main/player/bomb.cpp b/th02/main/player/bomb.cpp
index e4a2383c..22d1df80 100644
--- a/th02/main/player/bomb.cpp
+++ b/th02/main/player/bomb.cpp
@@ -127,7 +127,7 @@ void pascal near bomb_particle_put_8(screen_x_t left, screen_y_t top, int cel)
 	vram_offset_shift_fast_asm(di, left, _DX);
 
 	// ZUN bloat: _SI  = &sBOMB_PARTICLES[cel];
-	_SI = reinterpret_cast<uint16_t>(&sBOMB_PARTICLES[0][0]);
+	_SI = reinterpret_cast<uint16_t>(&sBOMB_PARTICLES[0].row[0]);
 	_AX = (cel * sizeof(sBOMB_PARTICLES[0]));
 	asm { add	si, ax; }
 
diff --git a/th02/main/spark.cpp b/th02/main/spark.cpp
index def54b07..bb8054e5 100644
--- a/th02/main/spark.cpp
+++ b/th02/main/spark.cpp
@@ -7,6 +7,16 @@
 #include "th02/main/scroll.hpp"
 #include "th02/hardware/pages.hpp"
 #include "libs/master.lib/pc98_gfx.hpp"
+#include "th02/sprites/bombpart.h"
+
+// Data
+// ----
+
+#include "th02/sprites/bombpart.csp"
+#include "th02/sprites/sparks.csp"
+
+Subpixel spark_accel_x = { 0 };
+// ----
 
 // ZUN landmine: sparks_add() insists on calling this function using a `near`
 // call with the current code segment. This will cause a fixup overflow if this
@@ -141,7 +151,7 @@ void pascal near grcg_spark_sprite_put(screen_x_t left, vram_y_t top, int cel)
 	_ES = SEG_PLANE_B;
 	left_copy = left;
 	_DI = vram_offset_shift_fast(left_copy, top);
-	_SI = reinterpret_cast<uint16_t>(&sSPARKS[left_copy & BYTE_MASK][cel][0]);
+	_SI = reinterpret_cast<uint16_t>(&sSPARKS[left_copy & BYTE_MASK][cel].row[0]);
 	_CX = SPARK_H;
 	put_loop: {
 		asm { movsw; }
diff --git a/th02/sprites/bombpart.h b/th02/sprites/bombpart.h
index db7cb7d6..fec019ee 100644
--- a/th02/sprites/bombpart.h
+++ b/th02/sprites/bombpart.h
@@ -6,7 +6,7 @@ static const int BOMB_PARTICLE_CELS = 4;
 
 typedef dots_t(BOMB_PARTICLE_W) bomb_particle_dots_t;
 
-extern const bomb_particle_dots_t sBOMB_PARTICLES[BOMB_PARTICLE_CELS + 1][
-	BOMB_PARTICLE_H
+extern const dot_rect_t(BOMB_PARTICLE_W, BOMB_PARTICLE_H) sBOMB_PARTICLES[
+	BOMB_PARTICLE_CELS + 1
 ];
-#define sBOMB_CIRCLE sBOMB_PARTICLES[BOMB_PARTICLE_CELS]
+#define sBOMB_CIRCLE sBOMB_PARTICLES[BOMB_PARTICLE_CELS].row
diff --git a/th02/sprites/sparks.h b/th02/sprites/sparks.h
index 341bc4aa..d9fce147 100644
--- a/th02/sprites/sparks.h
+++ b/th02/sprites/sparks.h
@@ -4,4 +4,4 @@
 #define SPARK_H 8
 static const unsigned int SPARK_CELS = 8;
 
-extern const dots16_t sSPARKS[PRESHIFT][SPARK_CELS][SPARK_H];
+extern const dot_rect_t(16, SPARK_H) sSPARKS[PRESHIFT][SPARK_CELS];
diff --git a/th02_main.asm b/th02_main.asm
index 881e2259..8356c304 100644
--- a/th02_main.asm
+++ b/th02_main.asm
@@ -750,10 +750,6 @@ public _aBomb1_bft
 _aBomb1_bft	db 'bomb1.bft',0
 public _asc_1E6DF
 _asc_1E6DF	db '  ',0
-include th02/sprites/bombpart.asp
-include th02/sprites/sparks.asp
-public _spark_accel_x
-_spark_accel_x	dw 0
 
 	.data?
 
