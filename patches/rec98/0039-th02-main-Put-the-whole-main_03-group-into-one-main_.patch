index 1286af92..d1747b63 100644
--- a/th02/main/boss/b3.cpp
+++ b/th02/main/boss/b3.cpp
@@ -12,7 +12,7 @@ extern screen_y_t stones_bullet_top;
 extern vram_y_t stones_y_22D9C;
 extern unsigned char angle_1E510;
 extern uint8_t pillar_frames_new;
-extern const char aBoss2_m[];
+extern char aBoss2_m[];
 
 void near dialog_pre(void);
 void near dialog_post(void);
@@ -954,16 +954,9 @@ void stones_init(void)
 	dialog_pre();
 	dialog_script_generic_part_animate(DS_PREBOSS);
 	dialog_post();
-	asm {
-		push	ds
-		push	offset aBoss2_m
-		nop
-		push	cs
-		call	near ptr sub_13ABB
-		add 	sp, 4
-	}
+	sub_13ABB(aBoss2_m);
 	stones_12778();
-	asm { nop; push cs; call near ptr sub_129FC; }
+	sub_129FC();
 }
 
 void near stones_12778(void)
@@ -989,7 +982,7 @@ void near stones_12778(void)
 	stone_top[STONE_NORTH] = (PLAYFIELD_TOP + 16);
 	stones_bullet_top = (PLAYFIELD_TOP + 24);
 	stones_bullet_left = (PLAYFIELD_LEFT + (PLAYFIELD_W / 2) - (PELLET_W / 2));
-	asm { nop; push cs; call near ptr sub_17A55; }
+	sub_17A55();
 	pillar_frames_new = 12;
 	stones_pattern_frame = 0;
 	stone_frames = 0;
