 th02/main/boss/mima.cpp    |  3 +--
 th02/main/boss/rika.cpp    |  4 ++--
 th02/main/boss/sigma.cpp   | 13 +++----------
 th02/main/enemy/enemy.cpp  |  2 +-
 th02/main/hittest.asm      |  6 +++---
 th02/main/pillar.cpp       |  2 +-
 th02/main_03_.asm          |  8 ++++----
 th02/marisa.cpp            |  2 +-
 th02/mima.cpp              |  2 +-
 th02/stage3.cpp            |  2 +-
 16 files changed, 28 insertions(+), 47 deletions(-)

