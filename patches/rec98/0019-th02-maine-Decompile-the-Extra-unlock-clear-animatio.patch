Subject: [PATCH] [th02/maine] Decompile the Extra unlock/clear animations and
 main(); resident rank and BGM mode are unsigned

---
 th02/end/end.cpp  |  80 ++++++++++++++++++++--
 th02/resident.hpp |   4 +-
 th02_maine.asm    | 166 ----------------------------------------------
 3 files changed, 77 insertions(+), 173 deletions(-)

diff --git a/th02/end/end.cpp b/th02/end/end.cpp
index 389dac34..7e70dca2 100644
--- a/th02/end/end.cpp
+++ b/th02/end/end.cpp
@@ -1,4 +1,6 @@
 #include <stddef.h>
+#include <process.h>
+#include "th01/rank.h"
 #include "planar.h"
 #include "libs/master.lib/master.hpp"
 #include "th01/hardware/egc.h"
@@ -1101,7 +1103,7 @@ void near staffroll_and_verdict_animate(void)
 
 	// Copyright
 	graph_accesspage(1);
-	verdict_label_put(8, VERDICT_LABEL_LEFT, VERDICT_COPYRIGHT "\0all.pi");
+	verdict_label_put(8, VERDICT_LABEL_LEFT, VERDICT_COPYRIGHT);
 	verdict_row_1_to_0_animate(
 		8, ((sizeof(VERDICT_COPYRIGHT) - 1) / sizeof(shiftjis_kanji_t))
 	);
@@ -1109,11 +1111,79 @@ void near staffroll_and_verdict_animate(void)
 	key_delay();
 	palette_black_out(5);
 
-	/* TODO: Replace with the decompiled call
-	* 	extra_unlock_animate();
-	* once that function is part of this translation unit */
-	_asm { nop; push cs; call near ptr extra_unlock_animate; }
+	extra_unlock_animate();
 
 	graph_clear();
 	/// -------
 }
+
+int scoredat_is_extra_unlocked(void);
+int cfg_load(void);
+int game_init_main(void);
+void game_exit(void);
+void regist_menu(void);
+
+void extra_unlock_animate(void)
+{
+	if(scoredat_is_extra_unlocked() && (resident->continues_used == 0)) {
+		pi_fullres_load_palette_apply_put_free(0, "all.pi");
+		palette_black_in(2);
+		frame_delay(150);
+		pi_fullres_load_palette_apply_put_free(0, "but.pi");
+		key_delay();
+		palette_black_out(5);
+	}
+}
+
+void extra_clear_animate(void)
+{
+	if(scoredat_is_extra_unlocked()) {
+		palette_settone(0);
+		pi_fullres_load_palette_apply_put_free(0, "all.pi");
+		palette_black_in(2);
+		frame_delay(150);
+		pi_fullres_load_palette_apply_put_free(0, "extra.pi");
+		key_delay();
+		palette_black_out(5);
+	}
+}
+
+int main(void)
+{
+	if(cfg_load() && (resident->stage == 0x7F)) {
+		game_init_main();
+		gaiji_backup();
+		gaiji_entry_bfnt("MIKOFT.bft");
+		snd_pmd_resident();
+		snd_mmd_resident();
+		if(resident->bgm_mode == SND_BGM_OFF) {
+			snd_midi_active = false;
+		} else if(resident->bgm_mode == SND_BGM_FM) {
+			snd_midi_active = false;
+			snd_determine_mode();
+		} else if(resident->bgm_mode == SND_BGM_MIDI) {
+			snd_midi_active = snd_midi_possible;
+			snd_determine_mode();
+		}
+		graph_accesspage(0);
+		graph_showpage(0);
+		super_entry_bfnt("endft.bft");
+		frame_delay(100);
+		if(resident->rank != RANK_EXTRA) {
+			if(resident->continues_used) {
+				end_bad_animate();
+			} else {
+				end_good_animate();
+			}
+			staffroll_and_verdict_animate();
+		} else {
+			extra_clear_animate();
+		}
+		palette_settone(50);
+		regist_menu();
+		palette_settone(0);
+		gaiji_restore();
+		game_exit();
+		execl("op", "op", NULL);
+	}
+}
