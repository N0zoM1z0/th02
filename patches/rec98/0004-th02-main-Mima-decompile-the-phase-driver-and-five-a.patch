--- a/th02_main.asm
+++ b/th02_main.asm
@@ -1210,9 +1210,9 @@ loc_B7DD:
 		setfarfp	_midboss_invalidate, @nullfunc_false$qv
 		setfarfp	_midboss_update_and_render, @nullfunc_void$qv
