From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: N0zoM1z0 <161784452+N0zoM1z0@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:33:23 +0100
Subject: [PATCH] Define the player's and tile TU's uninitialized variables in
 C++

---
 th02/main/player/player.cpp |  6 ++++--
 th02/main/tile/tile.cpp     | 29 ++++++++++++++++++-----------
 th02_main.asm               | 30 ------------------------------
 3 files changed, 22 insertions(+), 43 deletions(-)

diff --git a/th02/main/player/player.cpp b/th02/main/player/player.cpp
index 43cb18eb..9aecd119 100644
--- a/th02/main/player/player.cpp
+++ b/th02/main/player/player.cpp
@@ -30,6 +30,10 @@ extern int player_patnum; // ACTUAL TYPE: main_patnum_t
 // Function ordering fails
 // -----------------------
 
+// Uninitialized data, in the original order
+uint8_t shot_cooldown_1;
+uint8_t shot_cooldown_2;
+
 uint8_t total_miss_count = 0;
 
 extern const uint8_t POWER_RESET_FOR[SHOT_LEVEL_MAX + 1] = {
@@ -260,8 +264,6 @@ extern int8_t playchar_speed_diagonal_y;
 extern void (near *playchar_shot_func)(void);
 uint8_t shot_cycle_1 = 0xFF;
 uint8_t shot_cycle_2 = 0xFF;
-extern uint8_t shot_cooldown_1;
-extern uint8_t shot_cooldown_2;
 extern uint8_t shot_max_param_1;
 extern uint8_t shot_max_param_2;
 extern int8_t shot_max_spread;
diff --git a/th02/main/tile/tile.cpp b/th02/main/tile/tile.cpp
index d2666096..2817c4cf 100644
--- a/th02/main/tile/tile.cpp
+++ b/th02/main/tile/tile.cpp
@@ -20,24 +20,31 @@ typedef dots_t(TILE_W) tile_line_dots_t;
 // State
 // -----
 
-extern pixel_delta_8_t tile_line_at_top;
-extern vram_offset_t tile_image_vos[TILE_IMAGE_COUNT];
-extern pixel_t tile_copy_lines_top;
-extern pixel_t tile_copy_lines_h;
-
 // ZUN bloat: Just a redundant copy of a single tile ring row. Could have been
 // local to tiles_scroll_and_egc_render_both(), or just removed outright.
-extern tile_image_id_t tiles_for_new_row[TILES_X];
-
-extern tile_image_id_t tile_ring[TILES_Y][TILES_X];
-
-extern bool tile_dirty[TILES_X][TILES_Y];
 
 // Optimization to skip checking all vertical tiles for clean columns.
-extern bool tile_column_dirty[TILES_X];
 
 #pragma option -k-
 
+// Uninitialized data, in the original order
+#pragma option -a2
+map_section_tiles_t map_section_tiles[MAP_SECTION_COUNT];
+map_section_id_t map[MAP_LENGTH_MAX];
+unsigned int map_full_row_at_top_of_screen;
+pixel_delta_8_t tile_line_at_top;
+vram_offset_t tile_image_vos[TILE_IMAGE_COUNT];
+pixel_t tile_copy_lines_top;
+pixel_t tile_copy_lines_h;
+tile_image_id_t tiles_for_new_row[TILES_X];
+tile_mode_t tile_mode;
+tile_image_id_t tile_ring[TILES_Y][TILES_X];
+uint8_t tile_ring_unused; // ZUN bloat
+bool tile_dirty[TILES_X][TILES_Y];
+bool tile_column_dirty[TILES_X];
+bool tiles_egc_render_all;
+#pragma option -a-
+
 void tiles_stuff_reset(void)
 {
 	map_full_row_at_top_of_screen = (PLAYFIELD_H / TILE_H);
diff --git a/th02_main.asm b/th02_main.asm
index 16505fd9..c770a10f 100644
--- a/th02_main.asm
+++ b/th02_main.asm
@@ -983,35 +983,5 @@ public _bomb_b_tile_mode
 _bomb_b_tile_mode	db ?
 public _bomb_b_row
 _bomb_b_row	db ?
-public _map_section_tiles, _map, _map_full_row_at_top_of_screen
-_map_section_tiles	db (MAP_SECTION_COUNT * MAP_ROWS_PER_SECTION * TILES_X) dup (?)
-_map              	db MAP_LENGTH_MAX dup(?)
-_map_full_row_at_top_of_screen	dw ?
-
-TILE_COUNT = TILES_X * TILES_Y
-TM_COL_0 = 0
-TM_TILES = 1
-TM_NONE = 2
-
-public _tile_line_at_top, _tile_image_vos, _tile_copy_lines_top
-public _tile_copy_lines_h, _tiles_for_new_row, _tile_ring, _tile_dirty
-public _tile_column_dirty, _tile_mode, _tiles_egc_render_all
-_tile_line_at_top	db ?
-	evendata
-_tile_image_vos	dw TILE_IMAGE_COUNT dup(?)
-_tile_copy_lines_top	dw ?
-_tile_copy_lines_h  	dw ?
-_tiles_for_new_row  	db TILES_X dup(?)
-_tile_mode	db ?
-_tile_ring	db TILE_COUNT dup(?)
-	evendata
-_tile_dirty	db TILE_COUNT dup(?)
-_tile_column_dirty	db TILES_X dup(?)
-_tiles_egc_render_all	db ?
-	evendata
-public _shot_cooldown_1
-_shot_cooldown_1	db ?
-public _shot_cooldown_2
-_shot_cooldown_2	db ?
 
 		end
