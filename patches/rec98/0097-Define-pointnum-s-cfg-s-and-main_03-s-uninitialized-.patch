 th02/main_03.cpp                |  4 ++++
 th02/main_cfg.cpp               |  5 +++++
 th02_main.asm                   | 19 -------------------
 4 files changed, 10 insertions(+), 20 deletions(-)

diff --git a/th02/main/pointnum/pointnum.cpp b/th02/main/pointnum/pointnum.cpp
index ef13bcfc..229583ac 100644
--- a/th02/main/pointnum/pointnum.cpp
+++ b/th02/main/pointnum/pointnum.cpp
@@ -28,7 +28,7 @@ struct CPointnums {
 	pointnum_cel_t operand;
 };
 
-extern CPointnums pointnums;
+CPointnums pointnums;
 
 // Function ordering fails
 // -----------------------
diff --git a/th02/main_03.cpp b/th02/main_03.cpp
index b8946fde..5009c921 100644
--- a/th02/main_03.cpp
+++ b/th02/main_03.cpp
@@ -3,6 +3,10 @@
  * Code segment #3 of TH02's MAIN.EXE
  */
 
+#include "th02/main/spark.hpp"
+
+unsigned int spark_ring_i;
+
 #define RANDRING_INSTANCE 2
 #include "th02/math/randring.cpp"
 #include "th02/main/bullet/pellet_r.cpp"
diff --git a/th02/main_cfg.cpp b/th02/main_cfg.cpp
index 6a8070f2..e9bf81f8 100644
--- a/th02/main_cfg.cpp
+++ b/th02/main_cfg.cpp
@@ -32,6 +32,11 @@
 #include "th02/main/stage/stage.hpp"
 #include "th02/main/tile/tile.hpp"
 
+// Uninitialized data
+resident_t far *resident;
+int16_t resident_unused; // ZUN bloat
+int playperf;
+
 char rank = RANK_NORMAL;
 char stage_id = 0;
 
diff --git a/th02_main.asm b/th02_main.asm
index c547f889..d3df5f9b 100644
--- a/th02_main.asm
+++ b/th02_main.asm
@@ -672,12 +672,6 @@ public _byte_20168, _byte_20169
 _byte_20168	db ?
 _byte_20169	db ?
 include th02/math/randring[bss].asm
-public _resident, _playperf
-_resident	dd ?
-		db 2 dup(?)
-_playperf	dw ?
-public _spark_ring_i
-_spark_ring_i	dw ?
 
 POINTNUM_W = 8
 POINTNUM_H = 8
@@ -687,19 +681,6 @@ POINTNUM_MUL = 10
 POINTNUM_EMPTY = 12
 POINTNUM_COUNT = 20
 
-public _pointnums
-CPointnums struc
-	PN_col    	db ?
-	          	db ?
-	PN_left   	dw POINTNUM_COUNT dup(?)
-	PN_top    	dw POINTNUM_COUNT dup(2 dup(?))
-	PN_points 	dw POINTNUM_COUNT dup(?)
-	PN_flag   	db POINTNUM_COUNT dup(?)
-	PN_age    	db POINTNUM_COUNT dup(?)
-	PN_op     	db ?
-	PN_operand	db ?
-CPointnums ends
-_pointnums	CPointnums <?>
 
 
 BULLET_COUNT = 150
