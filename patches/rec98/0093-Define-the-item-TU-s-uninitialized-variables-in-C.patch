From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: N0zoM1z0 <161784452+N0zoM1z0@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:35:31 +0100
Subject: [PATCH] Define the item TU's uninitialized variables in C++

---
 th02/main/item/item.cpp | 25 +++++++++++++++----------
 th02_main.asm           | 20 --------------------
 2 files changed, 15 insertions(+), 30 deletions(-)

diff --git a/th02/main/item/item.cpp b/th02/main/item/item.cpp
index c7213f09..27f98419 100644
--- a/th02/main/item/item.cpp
+++ b/th02/main/item/item.cpp
@@ -77,7 +77,6 @@ struct item_t {
 // State
 // -----
 
-extern item_t items[ITEM_COUNT];
 
 #define p_left_ptr       	item_p_left_ptr
 #define p_top_ptr        	item_p_top_ptr
@@ -91,17 +90,26 @@ extern item_t items[ITEM_COUNT];
 
 // ZUN bloat: Should have been local to items_update_and_render(), and been a
 // single reference instead of two pointers.
-extern screen_x_t near* p_left_ptr;
-extern Subpixel near* p_top_ptr;
+#pragma option -a2
+item_t items[ITEM_COUNT];
+
+screen_x_t near* p_left_ptr;
+Subpixel near* p_top_ptr;
 
 // ZUN bloat: Could have been local to items_update_and_render().
-extern screen_x_t p_left;
-extern union {
+screen_x_t p_left;
+union {
 	screen_y_t screen;
 	vram_y_t vram;
 } p_top;
-extern uint8_t semirandom_ring_p;
-extern score_t item_score_this_frame;
+int point_items_collected;
+uint8_t semirandom_ring_p;
+bool items_miss_add_gameover;
+uint8_t semirandom_cycle;
+score_t item_score_this_frame;
+uint8_t collect_skill;
+int frame_unused; // ZUN bloat
+#pragma option -a-
 // -----
 
 void near items_init_and_reset(void)
@@ -123,7 +131,6 @@ void pascal items_add_semirandom(screen_x_t left, screen_y_t top)
 		return;
 	}
 
-	extern uint8_t semirandom_cycle;
 	if((semirandom_cycle++ % 3) != 0) {
 		return;
 	}
@@ -278,7 +285,6 @@ void near items_invalidate(void)
 // Returns `true` if the player collided with and collected the item.
 bool16 pascal near item_hittest_y(item_t near& item)
 {
-	extern uint8_t collect_skill;
 	screen_y_t top = p_top.screen;
 
 	// Translation: The 16×16 bounding box of an item must fully lie within the
@@ -394,7 +400,6 @@ bool16 pascal near item_hittest_y(item_t near& item)
 
 void near items_update_and_render(void)
 {
-	extern int frame_unused; // ZUN bloat
 	static uint8_t drop_cycle = 0;
 
 	item_t near* p = items;
diff --git a/th02_main.asm b/th02_main.asm
index 9845441c..2319efb4 100644
--- a/th02_main.asm
+++ b/th02_main.asm
@@ -924,26 +924,6 @@ item_t struc
 	ITEM_age                     	dw ?
 item_t ends
 
-public _items, _item_p_left_ptr, _item_p_top_ptr, _item_p_left, _item_p_top
-_items	item_t ITEM_COUNT dup(<?>)
-
-_item_p_left_ptr	dw ?
-_item_p_top_ptr 	dw ?
-_item_p_left    	dw ?
-_item_p_top     	dw ?
-
-public _point_items_collected, _item_semirandom_ring_p, _items_miss_add_gameover
-public _item_semirandom_cycle, _item_score_this_frame, _item_collect_skill
-public _item_frame_unused
-_point_items_collected	dw ?
-_item_semirandom_ring_p	db ?
-_items_miss_add_gameover	db ?
-_item_semirandom_cycle	db ?
-	evendata
-_item_score_this_frame	dd ?
-_item_collect_skill	db ?
-		db ?
-_item_frame_unused	dw ?
 
 
 		end
