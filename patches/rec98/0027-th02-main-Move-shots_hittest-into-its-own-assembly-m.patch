index 6389b4f7..fb61d7f2 100644
--- a/Tupfile.lua
+++ b/Tupfile.lua
@@ -530,6 +530,7 @@ th02:branch(MODEL_LARGE, { cflags = "-DBINARY='M'" }):link("main", {
 	"th02/main/player/shot.cpp",
 	"th02/main/player/bombanim.cpp",
 	"th02/main/boss/explode.cpp",
+	"th02/main/hittest.asm",
 	"th02/main/pillar.cpp",
 	"th01/vplanset.cpp",
